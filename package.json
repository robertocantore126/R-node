{
  "name": "r-node",
  "private": true,
  "version": "0.1.0",
  "description": "R-node — a cross-platform visual thinking and mind-mapping workspace",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:viewer": "vite build --config vite.viewer.config.ts",
    "predev": "npm run build:viewer",
    "prebuild": "npm run build:viewer"
  },
  "dependencies": {
    "@lexical/html": "^0.49.0",
    "@lexical/list": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/rich-text": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "@tauri-apps/plugin-http": "^2.5.9",
    "fflate": "^0.8.3",
    "lexical": "^0.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
