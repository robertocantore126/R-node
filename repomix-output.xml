const fs = require('fs');
const path = require('path');

const ROOT = path.resolve(__dirname, '..');
const SRC = path.join(ROOT, 'src');
const OUT_DIR = path.join(ROOT, 'docs');
const OUT_FILE = path.join(OUT_DIR, 'layout-bundle.html');

const allowedExt = new Set(['.ts', '.tsx', '.js', '.jsx', '.rs', '.css', '.json', '.md']);

async function walk(dir) {
  const entries = await fs.promises.readdir(dir, { withFileTypes: true });
  const files = [];
  for (const e of entries) {
    const full = path.join(dir, e.name);
    if (e.isDirectory()) {
      if (['node_modules', 'dist', '.git'].includes(e.name)) continue;
      files.push(...await walk(full));
    } else if (e.isFile()) {
      files.push(full);
    }
  }
  return files;
}

function escapeHtml(s) {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

(async () => {
  await fs.promises.mkdir(OUT_DIR, { recursive: true });
  const allFiles = await walk(SRC);
  const chosen = [];
  for (const f of allFiles) {
    const ext = path.extname(f).toLowerCase();
    if (!allowedExt.has(ext)) continue;
    const rel = path.relative(ROOT, f).replace(/\\/g, '/');
    const content = await fs.promises.readFile(f, 'utf8');
    // Always include specific core files useful for understanding layout
    const alwaysInclude = new Set(['src/core/doc.ts', 'src/core/ops.ts']);
    if (alwaysInclude.has(rel) || rel.startsWith('src/layout/') || /\blayout\b/i.test(content)) {
      chosen.push({ path: rel, content });
    }
  }

  chosen.sort((a, b) => a.path.localeCompare(b.path));

  const parts = [];
  parts.push('<!doctype html>');
  parts.push('<html><head><meta charset="utf-8"><title>Layout files bundle</title>');
  parts.push('<style>body{font-family:system-ui,Segoe UI,Roboto,Arial,Helvetica,sans-serif;padding:20px}h2{font-size:14px;margin-top:24px}pre{background:#f6f8fa;padding:12px;border-radius:6px;overflow:auto;white-space:pre-wrap}</style>');
  parts.push('</head><body>');
  parts.push('<h1>Layout-related files bundle</h1>');
  parts.push('<p>Generated by scripts/bundle_layout.cjs — includes files under <code>src/layout/</code> and any files mentioning the word "layout".</p>');

  for (const f of chosen) {
    parts.push(`<h2>${escapeHtml(f.path)}</h2>`);
    parts.push('<pre><code>');
    parts.push(escapeHtml(f.content));
    parts.push('</code></pre>');
  }

  parts.push('</body></html>');

  await fs.promises.writeFile(OUT_FILE, parts.join('\n'), 'utf8');
  console.log(`Wrote ${OUT_FILE} with ${chosen.length} files.`);
})();
